     "tableResultSettingsMap": {},
     "title": "Create UC function over bakehouse data"
    }
   },
   "outputs": [],
   "source": [
    "%sql\n",
    "-- UC table function exposed as an MCP tool via /api/2.0/mcp/functions/mfg_mc_se_sa/hobbs\n",
    "CREATE OR REPLACE FUNCTION mfg_mc_se_sa.hobbs.get_bakehouse_sales_by_country(\n",
    "  country STRING COMMENT 'Franchise country, e.g. US, Japan, Australia',\n",
    "  start_date DATE COMMENT 'Inclusive start date (yyyy-MM-dd)',\n",
    "  end_date DATE COMMENT 'Inclusive end date (yyyy-MM-dd)'\n",
    ")\n",
    "RETURNS TABLE (product STRING, transactions BIGINT, units BIGINT, revenue BIGINT)\n",
    "COMMENT 'Bakehouse sales summarized by product for one franchise country and date range'\n",
    "RETURN\n",
    "  SELECT t.product,\n",
    "         COUNT(*)           AS transactions,\n",
    "         SUM(t.quantity)    AS units,\n",
    "         SUM(t.totalPrice)  AS revenue\n",
    "  FROM samples.bakehouse.sales_transactions t\n",
    "  JOIN samples.bakehouse.sales_franchises f ON t.franchiseID = f.franchiseID\n",
    "  WHERE f.country = get_bakehouse_sales_by_country.country\n",
    "    AND CAST(t.dateTime AS DATE) BETWEEN start_date AND end_date\n",
    "  GROUP BY t.product\n",
    "  ORDER BY revenue DESC"
   ]
  },
  {
