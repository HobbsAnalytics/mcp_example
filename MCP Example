   "source": [
    "from databricks.sdk import WorkspaceClient\n",
    "from mcp import ClientSession\n",
    "from mcp.client.streamable_http import streamablehttp_client\n",
    "\n",
    "# ---- The only things to change for a different MCP server (e.g. Essbase) ----\n",
    "w = WorkspaceClient()\n",
    "MCP_URL = f\"{w.config.host}/api/2.0/mcp/functions/mfg_mc_se_sa/hobbs\"\n",
    "HEADERS = w.config.authenticate()  # {\"Authorization\": \"Bearer ...\"} from notebook auth\n",
    "TOOL_NAME = \"mfg_mc_se_sa__hobbs__get_bakehouse_sales_by_country\"\n",
    "TOOL_ARGS = {\"country\": \"Japan\", \"start_date\": \"2024-05-01\", \"end_date\": \"2024-05-17\"}\n",
    "\n",
    "# Essbase example (keep the token in a secret scope, never hard-code it):\n",
    "# MCP_URL   = \"https://<essbase-host>/<mcp-path>\"\n",
    "# HEADERS   = {\"Authorization\": f\"Bearer {dbutils.secrets.get('<scope>', '<key>')}\"}\n",
    "# TOOL_NAME = \"<tool name printed by list_tools below>\"\n",
    "# TOOL_ARGS = {...}\n",
    "# -----------------------------------------------------------------------------\n",
    "\n",
    "async with streamablehttp_client(MCP_URL, headers=HEADERS) as (read, write, _):\n",
    "    async with ClientSession(read, write) as session:\n",
    "        await session.initialize()\n",
    "        for t in (await session.list_tools()).tools:  # discover tools + expected args\n",
    "            print(t.name, t.inputSchema)\n",
    "        result = await session.call_tool(TOOL_NAME, TOOL_ARGS)\n",
    "\n",
    "for c in result.content:\n",
    "    print(c.text)"
   ]
  }
